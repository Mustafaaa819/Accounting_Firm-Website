---
import ScrollReveal from './ScrollReveal.astro';

interface Props {
  eyebrow?: string;
  title: string;
  /** Standfirst. Set larger than the body to open the column. */
  lead?: string;
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, id, class: className } = Astro.props;

const hasNote = Astro.slots.has('note');
---

{/*
  Text-led and dense: one narrow measure, tight paragraph spacing, no columns.
  Newsprint-style multi-column body was the obvious move here and was rejected —
  it forces the reader back up the page on every column break. The marginal note
  is hung outside the measure at xl and folds inline below that.
*/}
<section id={id} class:list={['mx-auto max-w-6xl px-6 py-24', className]}>
  <ScrollReveal class="relative mx-auto max-w-prose">
    {
      hasNote && (
        <aside class="mb-8 border-l-2 border-amber-soft pl-4 text-xs text-ink-muted xl:absolute xl:-left-56 xl:mb-0 xl:w-44 xl:border-l-0 xl:border-t xl:border-ink/20 xl:pl-0 xl:pt-3">
          <slot name="note" />
        </aside>
      )
    }

    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="mt-3 text-4xl">{title}</h2>

    {lead && <p class="mt-6 text-xl text-ink-soft">{lead}</p>}

    <div class="mt-6 text-ink-soft [&>blockquote]:text-ink [&>h3]:mt-8 [&>h3]:text-xl [&>p+p]:mt-3">
      <slot />
    </div>

    <div class="rule-double mt-12"></div>
  </ScrollReveal>
</section>
