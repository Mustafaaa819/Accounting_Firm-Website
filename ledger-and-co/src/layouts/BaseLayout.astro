---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Social share image, resolved against `site`. Replace the placeholder before launch. */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Ledger & Co. — chartered accountants for founders, funds and family businesses.',
  image = '/images/og-default.svg',
  noindex = false,
} = Astro.props;

const SITE_NAME = 'Ledger & Co.';

// `Astro.site` comes from astro.config.mjs. Both are absolute, which og:url and
// canonical require — relative URLs are ignored by most crawlers and scrapers.
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* PLACEHOLDER icons — swap for the real mark before launch. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#12203A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="generator" content={Astro.generator} />

    {/*
      Preload only the latin subsets — they cover the whole site's copy, so they
      are on the critical path. The latin-ext files stay unpreloaded and are
      fetched on demand by unicode-range. `crossorigin` is required even for
      same-origin fonts, otherwise the preload is discarded and re-fetched.
    */}
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Marks that scripting is available, before first paint. ScrollReveal's
      hidden state is gated on `html.js`, so if this never runs — JS disabled,
      blocked, or errored — content renders visible instead of stranded at
      opacity 0. Inline and in <head> on purpose: a bundled module would land
      after paint and flash the content before hiding it.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only no-underline focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper-bright"
    >
      Skip to content
    </a>

    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
