---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Social share image, resolved against `site`. Replace the placeholder before launch. */
  image?: string;
  /** Describes the share card for anyone who cannot see it. Change with `image`. */
  imageAlt?: string;
  /** `article` on a dated piece of writing, `website` on everything else. */
  ogType?: 'website' | 'article';
  /** Publication date, ISO. Only read when `ogType` is `article`. */
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Ledger & Co. — chartered accountants for founders, funds and family businesses.',
  image = '/images/og-default.png',
  imageAlt = 'Ledger & Co., chartered accountants.',
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const SITE_NAME = 'Ledger & Co.';

// The card's real pixel size. Facebook and LinkedIn reserve the slot from these
// before the image itself arrives, so a wrong pair reflows the preview; keep
// them in step with whatever `image` points at.
const IMAGE_WIDTH = '1200';
const IMAGE_HEIGHT = '630';

// `Astro.site` comes from astro.config.mjs. Both are absolute, which og:url and
// canonical require — relative URLs are ignored by most crawlers and scrapers.
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* PLACEHOLDER icons — swap for the real mark before launch. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#12203A" />

    <meta property="og:type" content={ogType} />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={IMAGE_WIDTH} />
    <meta property="og:image:height" content={IMAGE_HEIGHT} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="generator" content={Astro.generator} />

    {/*
      Preload only the latin subsets — they cover the whole site's copy, so they
      are on the critical path. The latin-ext files stay unpreloaded and are
      fetched on demand by unicode-range. `crossorigin` is required even for
      same-origin fonts, otherwise the preload is discarded and re-fetched.
    */}
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Marks that scripting is available, before first paint. ScrollReveal's
      hidden state is gated on `html.js`, so if this never runs — JS disabled,
      blocked, or errored — content renders visible instead of stranded at
      opacity 0. Inline and in <head> on purpose: a bundled module would land
      after paint and flash the content before hiding it.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only no-underline focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper-bright"
    >
      Skip to content
    </a>

    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
