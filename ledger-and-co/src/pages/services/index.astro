---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ScrollReveal from '../../components/ScrollReveal.astro';

// Editorial order, from the schema — the work a client usually buys first sits
// at the top. Sorting on `title` would open the list on Audit, which is the
// engagement fewest visitors arrive looking for.
const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Two digits so 01–05 share a width and the numbers stack into a true column
// down the page; `nums` in the markup keeps the digits tabular.
const index = (position: number) => String(position + 1).padStart(2, '0');
---

<BaseLayout
  title="Services — Ledger & Co."
  description="Bookkeeping, tax advisory, payroll, audit and business advisory — five engagements, each priced as a fixed scope."
>
  {/* ---------------------------------------------------------------------
      1. Page head.
  --------------------------------------------------------------------- */}
  <section class="mx-auto max-w-6xl px-6 pb-8 pt-16 sm:pt-24">
    <ScrollReveal y={12} class="lg:grid lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="eyebrow">Services</p>

        <h1 class="mt-6 text-4xl">Five engagements. One partner across all of them.</h1>

        <div class="rule-double mt-10"></div>
      </div>

      <p class="mt-8 text-lg text-ink-soft lg:col-span-4 lg:col-start-9 lg:mt-0">
        Most clients start with one of these and add a second inside a year.
        They are listed in the order they usually arrive, not in order of size —
        and each is scoped and priced before any work begins.
      </p>
    </ScrollReveal>
  </section>

  {/* ---------------------------------------------------------------------
      2. The list.

      A row per service, not a three-up grid of icon cards. Each row runs the
      full measure of the page: the title holds one end, the description and
      its link the other, and the pairing swaps sides on every second row so
      the eye travels down the page in a zigzag instead of a straight column.

      DOM order stays title → description on every row. The swap is done with
      `col-start` and `text-right`, so a screen reader and a keyboard user get
      the same sequence on every row regardless of which way it is laid out.
  --------------------------------------------------------------------- */}
  <section class="mx-auto max-w-6xl px-6 pb-24">
    {
      services.length > 0 ? (
        <ScrollReveal as="ol" stagger={0.08} class="mt-8 list-none pl-0">
          {services.map((service, position) => {
            const flipped = position % 2 === 1;

            return (
              <li class="group border-t border-ink/15 py-12 first:border-t-0 sm:py-16 lg:grid lg:grid-cols-12 lg:gap-8">
                <div
                  class:list={[
                    'lg:col-span-4',
                    flipped ? 'lg:col-start-9 lg:text-right' : 'lg:col-start-1',
                  ]}
                >
                  <p class="eyebrow nums">{index(position)}</p>

                  <h2 class="mt-3 text-3xl">
                    <a
                      href={`/services/${service.data.slug}`}
                      class="no-underline transition-colors group-hover:text-amber-deep"
                    >
                      {service.data.title}
                    </a>
                  </h2>
                </div>

                <div
                  class:list={[
                    'mt-5 lg:col-span-6 lg:mt-1',
                    flipped ? 'lg:col-start-1 lg:text-right' : 'lg:col-start-7',
                  ]}
                >
                  <p
                    class:list={[
                      'max-w-prose text-lg text-ink-soft',
                      flipped && 'lg:ml-auto',
                    ]}
                  >
                    {service.data.summary}
                  </p>

                  <p class="mt-6">
                    <a href={`/services/${service.data.slug}`} class="text-sm">
                      Learn more
                      {/* The service name is in the link's accessible name but
                          not on screen — "Learn more" five times over is a
                          useless link list to anyone navigating by links. */}
                      <span class="sr-only"> about {service.data.title}</span>
                      {/* inline-block keeps the arrow out of the underline:
                          text-decoration does not draw through an atomic
                          inline box. */}
                      <span
                        aria-hidden="true"
                        class="ml-2 inline-block transition-transform duration-200 group-hover:translate-x-1"
                      >
                        &rarr;
                      </span>
                    </a>
                  </p>
                </div>
              </li>
            );
          })}
        </ScrollReveal>
      ) : (
        /* The collection is Markdown-authored, so a fresh checkout can render
           this page with nothing in it. Same reasoning as the homepage: say
           something useful rather than collapse to a heading over a rule. */
        <ScrollReveal class="mt-8 border-t border-ink/15 pt-12">
          <p class="max-w-prose text-lg text-ink-soft">
            The written scopes are being drafted. Bookkeeping, tax, payroll,
            audit and advisory are all live engagements in the meantime — ask us
            what one would cover for a business your size.
          </p>
        </ScrollReveal>
      )
    }

    <div class="rule-double mt-4"></div>
  </section>

  {/* ---------------------------------------------------------------------
      3. Close.

      Deliberately quiet — a plain paper block, not a second navy CTA band.
      Every service page ends on the full band, and two of them a click apart
      would make the loud one stop reading as loud.
  --------------------------------------------------------------------- */}
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <ScrollReveal class="lg:grid lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="eyebrow">Not sure which one</p>
        <h2 class="mt-3 text-2xl">
          Most first conversations start with &ldquo;it is probably two of these&rdquo;.
        </h2>
        <p class="mt-5 max-w-prose text-ink-soft">
          Describe the situation and we will tell you which engagements it
          actually needs — including the ones you do not need yet.
        </p>
      </div>

      <div
        class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 lg:col-span-4 lg:col-start-9 lg:mt-0 lg:justify-end"
      >
        <Button href="/contact">Book a consultation</Button>
        <a href="tel:+442071234567" class="nums text-sm">+44 20 7123 4567</a>
      </div>
    </ScrollReveal>
  </section>
</BaseLayout>
